{% extends '@Interfacing/base.html.twig' %}
{% block body %}
<h2>Compliance config</h2>
<a href="{{ path('admin_compliance_config_new') }}">New</a>
<table>
  <tr><th>ID</th><th>Key</th><th>Value</th><th>Scope</th><th>Updated</th><th></th></tr>
  {% for item in items %}
    <tr>
      <td>{{ item.id }}</td>
      <td>{{ item.keyName }}</td>
      <td>{{ item.value }}</td>
      <td>{{ item.scope }}</td>
      <td>{{ item.updatedAt|date('Y-m-d H:i') }}</td>
      <td><a href="{{ path('admin_compliance_config_edit', {id: item.id}) }}">edit</a></td>
    </tr>
  {% endfor %}
</table>
{% endblock %}
